# Copy to deploy/ssh/.env.deploy (not tracked by git) and fill in.
# Only DEPLOY_* lines are read; variables set in the environment win.

# SSH host or ~/.ssh/config alias
DEPLOY_HOST=my-server

# Folder holding inventoros/ and public_html/, relative to the remote home
DEPLOY_ROOT=www/example.com

# PHP CLI binary on the server
DEPLOY_PHP=php
